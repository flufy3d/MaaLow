   "out": "f: 192-d feature"
  },
  {
   "name": "head",
   "call": "infer(\"dufu/unified_head3.onnx\", {image:<current frame>,roi:[120,30,840,530],size:96,color:\"rgb\",mean:0,std:1,frames:[0],post:\"none\", extra:[{name:\"seq\",dim:[1,30,207],data:<flat 6210 floats>}]})",
