{
 "model": "unified_head: frozen backbone (unified_back.onnx == back_best.pt) -> 192-d feature per frame; this model: 1-layer causal GRU (hidden 128) over 30 steps of [feat 192 | aux 15] = 207; 9 linear heads on the last step, concatenated",
 "io": {
  "inputs": [
   {
    "name": "img",
    "shape": [
     1,
     3,
     96,
     96
    ],
    "dtype": "float32",
    "note": "DETERMINISTICALLY UNUSED (verified identical out for different img). The runtime must still feed a screenshot because infer() requires an image input; pass the current frame."
   },
   {
    "name": "seq",
    "shape": [
     1,
     30,
     207
    ],
    "dtype": "float32",
    "note": "30 steps oldest..current, each [192 backbone features | 15 aux]; see aux below"
   }
  ],
  "output": {
   "name": "out",
   "shape": [
    1,
    77
   ],
   "dtype": "float32",
   "note": "concat heads in canonical order; slices below; apply softmax per head if probs wanted"
  }
 },
