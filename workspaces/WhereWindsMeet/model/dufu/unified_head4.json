{
 "model": "unified v4: backbone unified_back4.onnx = MobileNetV3-Small (exp6 fine-tuned blocks features[10],[11], further fine-tuned end-to-end on the v4 dataset: 219-232 live/A/B rounds with curtain de-loop + terminal quiet negatives), 192-d per frame; head unified_head4.onnx = 2-layer causal GRU (hidden 128) over 30 steps of [feat 192 | aux 15]. v4 label hygiene: def curtain(3) folded into unknown(4) during training (as v3); 219-232 tell curtain dropped (de-loop); terminal frames supervised quiet. IMPORTANT: head4 requires back4; switch both together.",
 "io": {
  "inputs": [
   {
    "name": "img",
    "shape": [
     1,
     3,
     96,
     96
    ],
    "dtype": "float32",
    "note": "DETERMINISTICALLY UNUSED by the head (verified identical out for different img); pass the current frame. For the BACKBONE this is the input (roi [120,30,840,530], size 96, rgb, 0-1)."
   },
   {
    "name": "seq",
    "shape": [
     1,
     30,
     207
    ],
    "dtype": "float32",
    "note": "30 steps oldest..current, each [192 backbone features | 15 aux]; see aux below"
   }
  ],
