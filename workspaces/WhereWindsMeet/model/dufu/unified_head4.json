 "aux": {
  "order": [
   "dt33",
   "since_parry",
   "since_dodge",
   "since_potion",
   "since_walk",
   "press_last3",
   "since_ok",
   "hp",
   "qi",
   "boss_ratio",
   "lit",
   "mean",
   "dark3",
   "flare",
   "boss_bar"
  ],
  "normalization": {
   "dt33": "realized dt between consecutive kept frames / 33.33, clip 0.5..3; first step = 1.0",
   "since_parry": "frames since last parry press / 3.0, cap 10 (0.1s units), 10 when none yet",
   "since_dodge": "same, dodge press",
   "since_potion": "same, potion press",
   "since_walk": "same, walk press",
   "press_last3": "1 if any of the last 3 frames (t-2..t) had a press from any of the 4 buttons, else 0",
   "since_ok": "frames since last successful parry (ok contact) / 3.0, cap 10",
   "hp": "clip(hp, 0, 1)",
   "qi": "clip(qi / 385, 0, 1)",
   "boss_ratio": "clip(boss_cur / 386, 0, 1) (boss current, fallback boss max)",
   "lit": "clip(glow / 500, 0, 1)",
   "mean": "clip(frame mean / 255, 0, 1)",
   "dark3": "1 if min(mean[t-2..t]) < 20 else 0",
   "flare": "1 if raw flare flag of the current frame",
   "boss_bar": "1 if boss bar present (boss > 50)"
  },
  "note": "exactly as the dataset stores them; the runtime must reproduce these columns. Column 0 is written per window from the realized capture dt."
 },
 "window": {
  "T": 30,
  "note": "runtime keeps the last 30 captured frames 1:1 (irregular ~35ms); feed them oldest..current."
 },
 "device_calls": [
  {
   "name": "backbone",
   "call": "infer(\"dufu/unified_back4.onnx\", {roi:[120,30,840,530],size:96,resize:\"area\",color:\"rgb\",mean:0,std:1,frames:[0],post:\"none\"})",
   "out": "f: 192-d feature"
  },
  {
   "name": "head",
   "call": "infer(\"dufu/unified_head4.onnx\", {image:<current frame>,roi:[120,30,840,530],size:96,color:\"rgb\",mean:0,std:1,frames:[0],post:\"none\", extra:[{name:\"seq\",dim:[1,30,207],data:<flat 6210 floats>}]})",
   "out": "out: 77-d (see slices); image is a dummy — the head ignores it"
  }
