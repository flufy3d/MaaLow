   "name": "backbone",
   "call": "infer(\"dufu/unified_back2.onnx\", {roi:[120,30,840,530],size:96,resize:\"area\",color:\"rgb\",mean:0,std:1,frames:[0],post:\"none\"})",
   "out": "f: 192-d feature"
  },
  {
   "name": "head",
   "call": "infer(\"dufu/unified_head2.onnx\", {image:<current frame>,roi:[120,30,840,530],size:96,color:\"rgb\",mean:0,std:1,frames:[0],post:\"none\", extra:[{name:\"seq\",dim:[1,30,207],data:<flat 6210 floats>}]})",
   "out": "out: 77-d (see slices); image is a dummy — the head ignores it"
  }
 ],
