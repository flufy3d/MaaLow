 "v8_slices_note": {
  "fut1f": "next contact (any type) in j+1 frames (j=0..44), 45 none (> 45 f or none). c_hat = t + sum_j p_j (j+1) / sum_{j<45} p_j; trained with Gaussian soft targets sigma 1 f",
  "ours": "our own action on screen now (aux target; diagnostics only)",
  "cont": "another boss contact within 30 f (offense gate's veto: use on the 0..12 f after a 卸势 ok)",
  "land": "probability that an action pressed now takes boss px within 1.2 s (probe on the frozen GRU state + current aux; offense rounds' result lines)"
 },
 "aux": {
  "order": [
   "dt33",
   "since_parry",
   "since_dodge",
   "since_potion",
   "since_walk",
   "press_last3",
   "since_ok",
   "hp",
   "qi",
   "boss_ratio",
   "lit",
   "mean",
   "dark3",
   "flare",
   "boss_bar"
  ],
  "normalization": {
   "dt33": "realized dt between consecutive kept frames / 33.33, clip 0.5..3; first step = 1.0",
   "since_parry": "frames since last parry press / 3.0, cap 10 (0.1s units), 10 when none yet",
   "since_dodge": "same, dodge press",
   "since_potion": "same, potion press",
   "since_walk": "same, walk press",
   "press_last3": "1 if any of the last 3 frames (t-2..t) had a press from any of the 4 buttons, else 0",
   "since_ok": "frames since last successful parry (ok contact) / 3.0, cap 10",
   "hp": "clip(hp, 0, 1)",
   "qi": "clip(qi / 385, 0, 1)",
   "boss_ratio": "clip(boss_cur / 386, 0, 1) (boss current, fallback boss max)",
   "lit": "clip(glow / 500, 0, 1)",
   "mean": "clip(frame mean / 255, 0, 1)",
   "dark3": "1 if min(mean[t-2..t]) < 20 else 0",
   "flare": "1 if raw flare flag of the current frame",
   "boss_bar": "1 if boss bar present (boss > 50)"
  },
  "note": "unchanged from v6"
 },
 "window": {
  "T": 30,
  "note": "runtime keeps the last 30 captured frames 1:1 (irregular ~35ms); feed oldest..current."
 },
 "device_calls": [
  {
   "name": "backbone",
   "call": "infer(\"dufu/unified_back9.onnx\", {roi:[120,30,840,530],size:96,resize:\"area\",color:\"rgb\",mean:0,std:1,frames:[0],post:\"none\"})"
  },
  {
   "name": "head",
   "call": "infer(\"dufu/unified_head_p2e.onnx\", {seq:<current 30x207 window>, extra:[{name:\"seq\",dim:[1,30,207],data_b64:\"<base64>\"}]})",
   "out": "out: 179-d (see slices; 0..132 = head p2 unchanged, 133..178 lead1f)",
   "note": "seq-only, no image/roi: do not feed the head a screenshot any more. The window travels as the compact `data_b64` - RFC 4648 standard base64, padding included, of the little-endian packed float32 array (24840 B -> 33120 chars; the same bytes as the old `data` JSON float array, ~33 kB instead of ~62 kB of text per call). Row-major, oldest frame first, each step = [192 backbone features | 15 aux, order below]."
  }
 ],
