    ],
    "size": [
     192,
     192
    ],
    "color": "bgr",
    "resize": "area",
    "mean": 0,
    "std": 1,
    "history": [
     {
      "name": "big",
      "aux": [
       0
      ]
     }
    ]
   },
   "output": "feat float32 [1, 96]"
  },
  "small": {
   "model": "crop.onnx",
   "input": "image float32 [1, 3, 192, 192] NCHW BGR, v / 255",
   "infer": {
    "roi": [
     425,
