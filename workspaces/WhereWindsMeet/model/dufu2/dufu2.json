     260,
     260
    ],
    "size": [
     192,
     192
    ],
    "color": "bgr",
    "resize": "area",
    "mean": 0,
    "std": 1,
    "history": [
     {
      "name": "small",
      "aux": [
       0
      ]
     }
    ]
   },
   "output": "feat float32 [1, 96]"
  },
  "head": {
   "model": "head.onnx",
   "inputs": {
    "glob": "float32 [1, 30, 132] = ring 'glob' (feature + contact history)",
    "big": "float32 [1, 30, 97] = ring 'big' (feature + one unused 0)",
    "small": "float32 [1, 30, 97] = ring 'small' (feature + one unused 0)"
   },
   "infer": {
    "extra": [
     {
      "name": "glob",
      "dim": [
       1,
       30,
       132
      ],
      "ring": true
     },
     {
      "name": "big",
      "dim": [
       1,
       30,
       97
      ],
      "ring": true
     },
     {
      "name": "small",
      "dim": [
       1,
       30,
       97
      ],
      "ring": true
     }
    ],
    "post": "none"
   },
   "output": "logits float32 [1, 141]"
  }
 },
 "screen": "1080x720 capture space; other sizes: s2_views.boxes(w, h)",
 "preprocessing": "s2_views.views(): INTER_AREA (infer resize 'area'), BGR as captured, fed as v / 255 (infer's default mean 0 / std 1: v * (1 / 255f)); x 255 and the ImageNet mean / std (on RGB, here reversed for BGR) are inside the backbones",
 "frame_rate": "the rings hold one entry per 30 fps frame (the training recordings); the head's receptive field is 29 frames (TCN, valid dilated convs (1, 2, 4, 7), kernel 3, 192 channels)",
 "contact_history": "4 values per frame (s3b_train.history): frames since the last contact known 6 frames after it /73 (cap 2; 2 = none), the two gaps before it /73 (cap 2; 2 = none), contacts in a row ending at it (gaps <= 73) /4 (cap 2; 0 if the last one is > 73 frames back). No contact yet: [2, 2, 2, 0]",
